{
  "manifest_version": 3,
  "name": "Fresh Stickies",
  "version": "0.2.0",
  "description": "Shared sticky notes on Freshdesk/Freshservice pages \u2014 visible to everyone with the extension until removed.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://*.freshdesk.com/*",
        "https://*.freshservice.com/*",
        "https://*.myfreshworks.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://mkjdaeqxjhartmzvfgqp.supabase.co/*"
  ]
}
