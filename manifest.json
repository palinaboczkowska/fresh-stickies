{
  "manifest_version": 3,
  "name": "Fresh Stickies",
  "version": "0.3.0",
  "description": "Shared sticky notes on Freshdesk/Freshservice pages \u2014 visible to everyone with the extension until removed.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.freshdesk.com/*",
        "https://*.freshservice.com/*",
        "https://*.myfreshworks.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://mkjdaeqxjhartmzvfgqp.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fresh Stickies \u2014 d\u00f6lj/visa lappar"
  }
}
